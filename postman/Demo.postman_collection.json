{
  "info": {
    "name": "Clase Docker - Productos JWT MySQL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Estado público",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/publico/estado",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Productos sin token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login (guardar token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"1234\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Crear producto (guardar id)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Teclado\", \"precio\": 29990}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"productoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Listar productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Buscar producto",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos/{{productoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Actualizar producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos/{{productoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Teclado mecánico\", \"precio\": 35990}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Eliminar producto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/productos/{{productoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Buscar eliminado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos/{{productoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Credenciales incorrectas",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"incorrecta\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Token inválido",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "abc.def.ghi",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Producto inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"\", \"precio\": -1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}